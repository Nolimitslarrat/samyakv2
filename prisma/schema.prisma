datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Float
  location    String
  area        Float    
  type        String   // Plot, Residential, Commercial, Land
  status      String   @default("Available") // Available, Sold, Under Negotiation
  featured    Boolean  @default(false)
  images      String   // Stored as JSON string
  video       String?  // Path to video file
  brochure    String?  // Path to PDF/Doc
  propertyPlan String? // Path to image
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model Enquiry {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  message   String?
  propertyId Int?
  type      String   @default("GENERAL") // GENERAL, PROPERTY, UPCOMING
  projectName String?
  emailCaptured String? // Store email from contact forms
  clientId  Int?
  client    Client?  @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  location    String
  launchDate  String?
  possessionDate String?
  status      String   @default("Upcoming") // Upcoming, Ongoing, Completed
  type        String   // Township, Commercial, Residential
  description String
  amenities   String   // JSON string of array
  highlights  String?  // JSON string or long text
  image       String   // Main hero image
  gallery     String?  // JSON string of array
  reraId      String?
  brochure    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id          Int      @id @default(autoincrement())
  name        String
  email       String?
  phone       String   @unique
  type        String   // "buyer", "seller", "both"
  source      String   @default("manual") // manual, contact_form, enquiry
  tags        String?  // JSON array: ["interested_in_plots", "budget_50L+"]
  preferences String?  // JSON: notification preferences
  isActive    Boolean  @default(true)
  optedOut    Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  notifications Notification[]
  enquiries     Enquiry[]
}

model Notification {
  id          Int      @id @default(autoincrement())
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String   // "email", "whatsapp"
  subject     String   // For emails
  content     String
  channel     String   // "property_alert", "project_alert", "manual"
  entityType  String?  // "property", "project"
  entityId    Int?
  status      String   @default("pending") // pending, sent, failed
  sentAt      DateTime?
  error       String?
  createdAt   DateTime @default(now())
}
